[{"data":1,"prerenderedAt":801},["ShallowReactive",2],{"blog-\u002Fblog\u002Fhosting-perevyshchennya-inodes":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"image":11,"body":12,"_type":795,"_id":796,"_source":797,"_file":798,"_stem":799,"_extension":800},"\u002Fblog\u002Fhosting-perevyshchennya-inodes","blog",false,"","Хостинг пише про перевищення inodes: що це таке і як звільнити файли на сервері","Отримали повідомлення від хостера про перевищення ліміту inodes? Розбираємо, що таке іноди, чому вони закінчуються, як знайти та видалити зайві файли на WordPress, OpenCart та інших CMS.","2026-07-29","\u002Fog-image.png",{"type":13,"children":14,"toc":767},"root",[15,23,29,36,54,65,73,128,140,146,153,165,177,183,195,201,240,246,251,257,293,299,304,310,316,321,327,339,345,372,378,384,394,404,421,431,437,442,491,503,509,514,537,543,552,558,567,572,578,606,612,686,692,697,715,727,754],{"type":16,"tag":17,"props":18,"children":20},"element","h1",{"id":19},"хостинг-пише-про-перевищення-inodes-що-це-таке-і-як-звільнити-файли-на-сервері",[21],{"type":22,"value":8},"text",{"type":16,"tag":24,"props":25,"children":26},"p",{},[27],{"type":22,"value":28},"Ще один «подарунок» від хостера в поштову скриньку: «Ваш хостинг-акаунт перевищив допустиму кількість inodes». Сайт починає працювати з перебоями, не можна завантажити нові файли, а ви навіть не розумієте, що таке ці загадкові «іноди». Ця проблема зустрічається не менш часто, ніж перевищення процесорних хвилин, і вирішується набагато простіше, ніж здається.",{"type":16,"tag":30,"props":31,"children":33},"h2",{"id":32},"що-таке-inodes-іноди",[34],{"type":22,"value":35},"Що таке inodes (іноди)?",{"type":16,"tag":24,"props":37,"children":38},{},[39,45,47,52],{"type":16,"tag":40,"props":41,"children":42},"strong",{},[43],{"type":22,"value":44},"Inode",{"type":22,"value":46}," — це запис у файловій системі сервера, який створюється для кожного файлу та папки. Один файл = один inode. Одна папка = один inode. Це не про розмір файлів, а про їхню ",{"type":16,"tag":40,"props":48,"children":49},{},[50],{"type":22,"value":51},"кількість",{"type":22,"value":53},".",{"type":16,"tag":24,"props":55,"children":56},{},[57,59,64],{"type":22,"value":58},"Тобто навіть якщо ваш хостинг-акаунт займає лише 2 ГБ з доступних 10 ГБ, але на ньому 300 000 дрібних файлів — ви можете вичерпати ліміт inodes. Більшість шаред-хостингів (Hosting Ukraine, Cityhost, FreeHost) встановлюють ліміт у ",{"type":16,"tag":40,"props":60,"children":61},{},[62],{"type":22,"value":63},"200 000 – 500 000 inodes",{"type":22,"value":53},{"type":16,"tag":24,"props":66,"children":67},{},[68],{"type":16,"tag":40,"props":69,"children":70},{},[71],{"type":22,"value":72},"Простий приклад:",{"type":16,"tag":74,"props":75,"children":76},"ul",{},[77,92,104,116],{"type":16,"tag":78,"props":79,"children":80},"li",{},[81,83,90],{"type":22,"value":82},"Фотографія ",{"type":16,"tag":84,"props":85,"children":87},"code",{"className":86},[],[88],{"type":22,"value":89},"photo.jpg",{"type":22,"value":91}," = 1 inode",{"type":16,"tag":78,"props":93,"children":94},{},[95,97,103],{"type":22,"value":96},"Папка ",{"type":16,"tag":84,"props":98,"children":100},{"className":99},[],[101],{"type":22,"value":102},"\u002Fimages\u002F",{"type":22,"value":91},{"type":16,"tag":78,"props":105,"children":106},{},[107,109,115],{"type":22,"value":108},"PHP-файл плагіна ",{"type":16,"tag":84,"props":110,"children":112},{"className":111},[],[113],{"type":22,"value":114},"plugin.php",{"type":22,"value":91},{"type":16,"tag":78,"props":117,"children":118},{},[119,121,127],{"type":22,"value":120},"Кеш-файл ",{"type":16,"tag":84,"props":122,"children":124},{"className":123},[],[125],{"type":22,"value":126},"cache_page_123.html",{"type":22,"value":91},{"type":16,"tag":24,"props":129,"children":130},{},[131,133,138],{"type":22,"value":132},"А тепер уявіть: свіжий WordPress з однією темою та десятком плагінів — це вже ",{"type":16,"tag":40,"props":134,"children":135},{},[136],{"type":22,"value":137},"30 000 – 50 000 файлів",{"type":22,"value":139},". Додайте кеш, бекапи, логи, завантажені медіафайли — і ліміт вичерпано.",{"type":16,"tag":30,"props":141,"children":143},{"id":142},"чому-іноди-закінчуються-головні-причини",[144],{"type":22,"value":145},"Чому іноди закінчуються: головні причини",{"type":16,"tag":147,"props":148,"children":150},"h3",{"id":149},"_1-файли-кешу-причина-1",[151],{"type":22,"value":152},"1. Файли кешу (причина №1)",{"type":16,"tag":24,"props":154,"children":155},{},[156,158,163],{"type":22,"value":157},"Плагіни кешування (LiteSpeed Cache, W3 Total Cache, WP Super Cache) створюють окремий HTML-файл для ",{"type":16,"tag":40,"props":159,"children":160},{},[161],{"type":22,"value":162},"кожної сторінки",{"type":22,"value":164}," вашого сайту. Якщо у вас інтернет-магазин з 10 000 товарів — це мінімум 10 000 файлів кешу. А якщо кеш створюється окремо для мобільної та десктопної версії — уже 20 000.",{"type":16,"tag":24,"props":166,"children":167},{},[168,170,175],{"type":22,"value":169},"Додайте сюди кеш для різних валют, мов, cookie-варіацій — і кількість файлів може сягати ",{"type":16,"tag":40,"props":171,"children":172},{},[173],{"type":22,"value":174},"100 000+",{"type":22,"value":176}," тільки від одного плагіна.",{"type":16,"tag":147,"props":178,"children":180},{"id":179},"_2-старі-бекапи-на-хостингу",[181],{"type":22,"value":182},"2. Старі бекапи на хостингу",{"type":16,"tag":24,"props":184,"children":185},{},[186,188,193],{"type":22,"value":187},"Багато хто налаштовує автоматичні бекапи (через UpdraftPlus, All-in-One WP Migration або вбудовані засоби хостингу) і забуває про них. Кожен бекап — це ZIP-архів, але деякі плагіни зберігають бекапи ",{"type":16,"tag":40,"props":189,"children":190},{},[191],{"type":22,"value":192},"без архівації",{"type":22,"value":194},", просто копіюючи всі файли сайту. Три такі бекапи — і ви втричі перевищили ліміт.",{"type":16,"tag":147,"props":196,"children":198},{"id":197},"_3-логи-та-тимчасові-файли",[199],{"type":22,"value":200},"3. Логи та тимчасові файли",{"type":16,"tag":74,"props":202,"children":203},{},[204,217,230,235],{"type":16,"tag":78,"props":205,"children":206},{},[207,209,215],{"type":22,"value":208},"Файли сесій PHP (",{"type":16,"tag":84,"props":210,"children":212},{"className":211},[],[213],{"type":22,"value":214},"\u002Ftmp\u002Fsess_*",{"type":22,"value":216},") — можуть накопичуватися тисячами",{"type":16,"tag":78,"props":218,"children":219},{},[220,222,228],{"type":22,"value":221},"Логи помилок (",{"type":16,"tag":84,"props":223,"children":225},{"className":224},[],[226],{"type":22,"value":227},"error_log",{"type":22,"value":229},") — можуть бути в кожній папці сайту",{"type":16,"tag":78,"props":231,"children":232},{},[233],{"type":22,"value":234},"Тимчасові файли завантажень",{"type":16,"tag":78,"props":236,"children":237},{},[238],{"type":22,"value":239},"Файли email-черги",{"type":16,"tag":147,"props":241,"children":243},{"id":242},"_4-невидалені-плагіни-та-теми-wordpress",[244],{"type":22,"value":245},"4. Невидалені плагіни та теми (WordPress)",{"type":16,"tag":24,"props":247,"children":248},{},[249],{"type":22,"value":250},"Кожна тема WordPress — це 500–2000 файлів. Кожен плагін — від 50 до 5000 файлів. Якщо ви встановили 10 тем «на спробу» і не видалили 8 з них — це десятки тисяч непотрібних файлів.",{"type":16,"tag":147,"props":252,"children":254},{"id":253},"_5-node_modules-та-файли-розробки",[255],{"type":22,"value":256},"5. Node_modules та файли розробки",{"type":16,"tag":24,"props":258,"children":259},{},[260,262,268,270,275,277,283,285,291],{"type":22,"value":261},"Якщо розробник залишив на хостингу папку ",{"type":16,"tag":84,"props":263,"children":265},{"className":264},[],[266],{"type":22,"value":267},"node_modules",{"type":22,"value":269}," — це легко ",{"type":16,"tag":40,"props":271,"children":272},{},[273],{"type":22,"value":274},"50 000 – 200 000 файлів",{"type":22,"value":276}," одним ударом. Те саме стосується ",{"type":16,"tag":84,"props":278,"children":280},{"className":279},[],[281],{"type":22,"value":282},".git",{"type":22,"value":284},", ",{"type":16,"tag":84,"props":286,"children":288},{"className":287},[],[289],{"type":22,"value":290},"vendor",{"type":22,"value":292}," з усіма dev-залежностями, папок збірки тощо.",{"type":16,"tag":147,"props":294,"children":296},{"id":295},"_6-мініатюри-зображень",[297],{"type":22,"value":298},"6. Мініатюри зображень",{"type":16,"tag":24,"props":300,"children":301},{},[302],{"type":22,"value":303},"WordPress автоматично створює кілька копій кожного завантаженого зображення (мініатюра, середній розмір, великий розмір, та інші, задані темою). Завантажили 1 000 фото — отримали 5 000 – 8 000 файлів.",{"type":16,"tag":30,"props":305,"children":307},{"id":306},"як-дізнатися-скільки-inodes-використовується",[308],{"type":22,"value":309},"Як дізнатися, скільки inodes використовується?",{"type":16,"tag":147,"props":311,"children":313},{"id":312},"через-cpanel",[314],{"type":22,"value":315},"Через cPanel",{"type":16,"tag":24,"props":317,"children":318},{},[319],{"type":22,"value":320},"Зайдіть у cPanel → на головній сторінці в бічній панелі буде показник «Inodes Used» або «File Usage».",{"type":16,"tag":147,"props":322,"children":324},{"id":323},"через-ssh-якщо-є-доступ",[325],{"type":22,"value":326},"Через SSH (якщо є доступ)",{"type":16,"tag":328,"props":329,"children":334},"pre",{"className":330,"code":332,"language":333,"meta":7},[331],"language-bash","# Загальна кількість файлів на акаунті\nfind \u002Fhome\u002Fusername\u002F -type f | wc -l\n\n# Кількість файлів у кожній папці (топ-10 найбільших)\nfind \u002Fhome\u002Fusername\u002Fpublic_html\u002F -type d -exec sh -c 'echo \"$(find \"{}\" -maxdepth 1 -type f | wc -l) {}\"' \\; | sort -rn | head -20\n\n# Знайти папки з найбільшою кількістю файлів\ndu --inodes -S \u002Fhome\u002Fusername\u002Fpublic_html\u002F | sort -rn | head -20\n