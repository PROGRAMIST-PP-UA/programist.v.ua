[{"data":1,"prerenderedAt":672},["ShallowReactive",2],{"blog-\u002Fblog\u002Fhosting-blokuye-poshtu-z-saytu":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"image":11,"body":12,"_type":666,"_id":667,"_source":668,"_file":669,"_stem":670,"_extension":671},"\u002Fblog\u002Fhosting-blokuye-poshtu-z-saytu","blog",false,"","Хостинг блокує пошту з сайту: чому листи не відправляються і як це виправити","Отримали від хостингу повідомлення про некоректні адреси відправників? Розбираємо, чому хостинг блокує пошту з вашого сайту, як правильно налаштувати відправку листів через SMTP та уникнути потрапляння в спам.","2026-07-29","\u002Fog-image.png",{"type":13,"children":14,"toc":647},"root",[15,23,29,34,41,63,90,100,106,113,126,132,137,149,162,168,181,187,192,198,204,209,235,241,258,266,271,281,291,299,308,314,332,349,406,416,425,431,436,446,454,463,473,491,499,504,510,570,576,609,634],{"type":16,"tag":17,"props":18,"children":20},"element","h1",{"id":19},"хостинг-блокує-пошту-з-сайту-чому-листи-не-відправляються-і-як-це-виправити",[21],{"type":22,"value":8},"text",{"type":16,"tag":24,"props":25,"children":26},"p",{},[27],{"type":22,"value":28},"Одного ранку ви отримуєте від хостера тривожний лист: «З вашого хостинг-акаунта зафіксовано спроби надсилання листів з некоректних адрес відправників». Форма зворотного зв'язку на сайті перестала працювати, заявки від клієнтів не доходять, а ви навіть не знаєте, з якого моменту це почалося. Знайома ситуація? Ви не одні — ця проблема масово виникає у власників сайтів на WordPress, OpenCart, Laravel та інших CMS.",{"type":16,"tag":24,"props":30,"children":31},{},[32],{"type":22,"value":33},"Давайте розберемося, чому це відбувається і як це виправити раз і назавжди.",{"type":16,"tag":35,"props":36,"children":38},"h2",{"id":37},"суть-проблеми-що-саме-блокує-хостинг",[39],{"type":22,"value":40},"Суть проблеми: що саме блокує хостинг?",{"type":16,"tag":24,"props":42,"children":43},{},[44,46,53,55,61],{"type":22,"value":45},"Коли хтось залишає заявку на вашому сайті, CMS формує лист і відправляє його через вбудовану функцію ",{"type":16,"tag":47,"props":48,"children":50},"code",{"className":49},[],[51],{"type":22,"value":52},"mail()",{"type":22,"value":54},". І ось тут починається проблема: сайт підставляє адресу відправника, яка ",{"type":16,"tag":56,"props":57,"children":58},"strong",{},[59],{"type":22,"value":60},"не належить вашому хостингу",{"type":22,"value":62},".",{"type":16,"tag":24,"props":64,"children":65},{},[66,68,74,76,81,83,88],{"type":22,"value":67},"Наприклад, клієнт залишив заявку через форму, вказавши свою пошту ",{"type":16,"tag":47,"props":69,"children":71},{"className":70},[],[72],{"type":22,"value":73},"ivan@gmail.com",{"type":22,"value":75},". Ваш сайт бере цю адресу і намагається відправити лист ",{"type":16,"tag":56,"props":77,"children":78},{},[79],{"type":22,"value":80},"від імені",{"type":22,"value":82}," ",{"type":16,"tag":47,"props":84,"children":86},{"className":85},[],[87],{"type":22,"value":73},{"type":22,"value":89},". Але ваш хостинг — це не Gmail. Він не має права відправляти листи від імені чужого домену.",{"type":16,"tag":24,"props":91,"children":92},{},[93,98],{"type":16,"tag":56,"props":94,"children":95},{},[96],{"type":22,"value":97},"Результат:",{"type":22,"value":99}," хостер блокує такі листи, а популярні поштові сервіси (Gmail, Outlook, Ukr.net) відхиляють їх або кидають у спам. Це погіршує репутацію IP-адреси хостингу та створює проблеми всім його користувачам.",{"type":16,"tag":35,"props":101,"children":103},{"id":102},"типові-причини-проблеми",[104],{"type":22,"value":105},"Типові причини проблеми",{"type":16,"tag":107,"props":108,"children":110},"h3",{"id":109},"_1-адреса-відправника-в-налаштуваннях-cms-email-клієнта",[111],{"type":22,"value":112},"1. Адреса відправника в налаштуваннях CMS = email клієнта",{"type":16,"tag":24,"props":114,"children":115},{},[116,118,124],{"type":22,"value":117},"Найпоширеніша помилка. У WordPress-плагінах форм (Contact Form 7, WPForms) часто є поле «From» (Від кого). Якщо туди підставляється email відвідувача сайту (наприклад, через тег ",{"type":16,"tag":47,"props":119,"children":121},{"className":120},[],[122],{"type":22,"value":123},"[your-email]",{"type":22,"value":125},"), хостинг заблокує відправку.",{"type":16,"tag":107,"props":127,"children":129},{"id":128},"_2-у-коді-сайту-жорстко-вписана-стороння-адреса",[130],{"type":22,"value":131},"2. У коді сайту жорстко вписана стороння адреса",{"type":16,"tag":24,"props":133,"children":134},{},[135],{"type":22,"value":136},"Деякі розробники прописують у коді щось на кшталт:",{"type":16,"tag":138,"props":139,"children":144},"pre",{"code":140,"language":141,"meta":7,"className":142},"mail($to, $subject, $message, \"From: info@gmail.com\");\n","php",[143],"language-php",[145],{"type":16,"tag":47,"props":146,"children":147},{"__ignoreMap":7},[148],{"type":22,"value":140},{"type":16,"tag":24,"props":150,"children":151},{},[152,154,160],{"type":22,"value":153},"Адреса ",{"type":16,"tag":47,"props":155,"children":157},{"className":156},[],[158],{"type":22,"value":159},"info@gmail.com",{"type":22,"value":161}," — не ваша. Хостинг не дозволить відправити лист від імені Gmail.",{"type":16,"tag":107,"props":163,"children":165},{"id":164},"_3-не-створена-поштова-скринька-на-хостингу",[166],{"type":22,"value":167},"3. Не створена поштова скринька на хостингу",{"type":16,"tag":24,"props":169,"children":170},{},[171,173,179],{"type":22,"value":172},"Навіть якщо ви вказали ",{"type":16,"tag":47,"props":174,"children":176},{"className":175},[],[177],{"type":22,"value":178},"info@vash-domen.ua",{"type":22,"value":180}," як відправника, але не створили цю скриньку в панелі керування хостингом — лист може бути заблокований або потрапити в спам, бо поштові сервери не зможуть підтвердити існування відправника.",{"type":16,"tag":107,"props":182,"children":184},{"id":183},"_4-відсутні-dns-записи-spf-dkim-dmarc",[185],{"type":22,"value":186},"4. Відсутні DNS-записи SPF, DKIM, DMARC",{"type":16,"tag":24,"props":188,"children":189},{},[190],{"type":22,"value":191},"Без цих записів поштові сервери одержувачів не можуть перевірити, чи ваш хостинг має право відправляти пошту від імені вашого домену. Навіть якщо лист відправиться — він, скоріше за все, потрапить у спам.",{"type":16,"tag":35,"props":193,"children":195},{"id":194},"як-виправити-покрокова-інструкція",[196],{"type":22,"value":197},"Як виправити: покрокова інструкція",{"type":16,"tag":107,"props":199,"children":201},{"id":200},"крок-1-створіть-поштову-скриньку-на-хостингу",[202],{"type":22,"value":203},"Крок 1. Створіть поштову скриньку на хостингу",{"type":16,"tag":24,"props":205,"children":206},{},[207],{"type":22,"value":208},"Зайдіть у панель керування хостингом (cPanel, DirectAdmin, ISPmanager) і створіть поштову скриньку, наприклад:",{"type":16,"tag":210,"props":211,"children":212},"ul",{},[213,225],{"type":16,"tag":214,"props":215,"children":216},"li",{},[217,223],{"type":16,"tag":47,"props":218,"children":220},{"className":219},[],[221],{"type":22,"value":222},"noreply@vash-domen.ua",{"type":22,"value":224}," — для автоматичних сповіщень",{"type":16,"tag":214,"props":226,"children":227},{},[228,233],{"type":16,"tag":47,"props":229,"children":231},{"className":230},[],[232],{"type":22,"value":178},{"type":22,"value":234}," — для форм зворотного зв'язку",{"type":16,"tag":107,"props":236,"children":238},{"id":237},"крок-2-змініть-адресу-відправника-в-cms",[239],{"type":22,"value":240},"Крок 2. Змініть адресу відправника в CMS",{"type":16,"tag":24,"props":242,"children":243},{},[244,249,251,256],{"type":16,"tag":56,"props":245,"children":246},{},[247],{"type":22,"value":248},"WordPress (Contact Form 7):",{"type":22,"value":250},"\nПерейдіть у налаштування форми → вкладка «Лист» → у полі «Від» (From) замініть ",{"type":16,"tag":47,"props":252,"children":254},{"className":253},[],[255],{"type":22,"value":123},{"type":22,"value":257}," на вашу скриньку:",{"type":16,"tag":138,"props":259,"children":261},{"code":260},"info@vash-domen.ua\n",[262],{"type":16,"tag":47,"props":263,"children":264},{"__ignoreMap":7},[265],{"type":22,"value":260},{"type":16,"tag":24,"props":267,"children":268},{},[269],{"type":22,"value":270},"А email клієнта підставте у поле «Reply-To» (Відповісти на), щоб при натисканні «Відповісти» лист ішов саме клієнту.",{"type":16,"tag":24,"props":272,"children":273},{},[274,279],{"type":16,"tag":56,"props":275,"children":276},{},[277],{"type":22,"value":278},"WordPress (WPForms \u002F Elementor Forms):",{"type":22,"value":280},"\nАналогічно: у полі «From Email» вкажіть корпоративну пошту, а email відвідувача — лише в «Reply-To».",{"type":16,"tag":24,"props":282,"children":283},{},[284,289],{"type":16,"tag":56,"props":285,"children":286},{},[287],{"type":22,"value":288},"OpenCart:",{"type":22,"value":290},"\nУ адмін-панелі: Система → Налаштування → вкладка «Пошта» → вкажіть вашу корпоративну адресу.",{"type":16,"tag":24,"props":292,"children":293},{},[294],{"type":16,"tag":56,"props":295,"children":296},{},[297],{"type":22,"value":298},"У власному PHP-коді:",{"type":16,"tag":138,"props":300,"children":303},{"code":301,"language":141,"meta":7,"className":302},"\u002F\u002F ❌ Неправильно:\n$headers = \"From: \" . $_POST['email'];\n\n\u002F\u002F ✅ Правильно:\n$headers  = \"From: info@vash-domen.ua\\r\\n\";\n$headers .= \"Reply-To: \" . $_POST['email'];\n",[143],[304],{"type":16,"tag":47,"props":305,"children":306},{"__ignoreMap":7},[307],{"type":22,"value":301},{"type":16,"tag":107,"props":309,"children":311},{"id":310},"крок-3-налаштуйте-відправку-через-smtp-рекомендовано",[312],{"type":22,"value":313},"Крок 3. Налаштуйте відправку через SMTP (рекомендовано)",{"type":16,"tag":24,"props":315,"children":316},{},[317,319,324,326,331],{"type":22,"value":318},"Стандартна PHP-функція ",{"type":16,"tag":47,"props":320,"children":322},{"className":321},[],[323],{"type":22,"value":52},{"type":22,"value":325}," відправляє листи «напряму» з сервера, без авторизації. Це ненадійно і часто блокується. Набагато краще — ",{"type":16,"tag":56,"props":327,"children":328},{},[329],{"type":22,"value":330},"відправляти пошту через SMTP з авторизацією",{"type":22,"value":62},{"type":16,"tag":24,"props":333,"children":334},{},[335,340,342,347],{"type":16,"tag":56,"props":336,"children":337},{},[338],{"type":22,"value":339},"Для WordPress",{"type":22,"value":341}," встановіть плагін ",{"type":16,"tag":56,"props":343,"children":344},{},[345],{"type":22,"value":346},"WP Mail SMTP",{"type":22,"value":348}," і налаштуйте:",{"type":16,"tag":210,"props":350,"children":351},{},[352,365,386,396,401],{"type":16,"tag":214,"props":353,"children":354},{},[355,357,363],{"type":22,"value":356},"SMTP-сервер: ",{"type":16,"tag":47,"props":358,"children":360},{"className":359},[],[361],{"type":22,"value":362},"mail.vash-domen.ua",{"type":22,"value":364}," (уточніть у хостера)",{"type":16,"tag":214,"props":366,"children":367},{},[368,370,376,378,384],{"type":22,"value":369},"Порт: ",{"type":16,"tag":47,"props":371,"children":373},{"className":372},[],[374],{"type":22,"value":375},"465",{"type":22,"value":377}," (SSL) або ",{"type":16,"tag":47,"props":379,"children":381},{"className":380},[],[382],{"type":22,"value":383},"587",{"type":22,"value":385}," (TLS)",{"type":16,"tag":214,"props":387,"children":388},{},[389,391],{"type":22,"value":390},"Логін: ",{"type":16,"tag":47,"props":392,"children":394},{"className":393},[],[395],{"type":22,"value":178},{"type":16,"tag":214,"props":397,"children":398},{},[399],{"type":22,"value":400},"Пароль: пароль від цієї скриньки",{"type":16,"tag":214,"props":402,"children":403},{},[404],{"type":22,"value":405},"Шифрування: SSL або TLS",{"type":16,"tag":24,"props":407,"children":408},{},[409,414],{"type":16,"tag":56,"props":410,"children":411},{},[412],{"type":22,"value":413},"Для PHP \u002F Laravel:",{"type":22,"value":415},"\nВикористовуйте бібліотеку PHPMailer або вбудований Mail у Laravel:",{"type":16,"tag":138,"props":417,"children":420},{"code":418,"language":141,"meta":7,"className":419},"\u002F\u002F .env (Laravel)\nMAIL_MAILER=smtp\nMAIL_HOST=mail.vash-domen.ua\nMAIL_PORT=465\nMAIL_USERNAME=info@vash-domen.ua\nMAIL_PASSWORD=ваш_пароль\nMAIL_ENCRYPTION=ssl\nMAIL_FROM_ADDRESS=info@vash-domen.ua\n",[143],[421],{"type":16,"tag":47,"props":422,"children":423},{"__ignoreMap":7},[424],{"type":22,"value":418},{"type":16,"tag":107,"props":426,"children":428},{"id":427},"крок-4-додайте-dns-записи-spf-dkim-та-dmarc",[429],{"type":22,"value":430},"Крок 4. Додайте DNS-записи SPF, DKIM та DMARC",{"type":16,"tag":24,"props":432,"children":433},{},[434],{"type":22,"value":435},"Ці записи підтверджують поштовим серверам, що ваш хостинг має право відправляти пошту від імені вашого домену.",{"type":16,"tag":24,"props":437,"children":438},{},[439,444],{"type":16,"tag":56,"props":440,"children":441},{},[442],{"type":22,"value":443},"SPF",{"type":22,"value":445}," — додайте TXT-запис у DNS вашого домену:",{"type":16,"tag":138,"props":447,"children":449},{"code":448},"v=spf1 include:spf.hosting-ukraine.com.ua ~all\n",[450],{"type":16,"tag":47,"props":451,"children":452},{"__ignoreMap":7},[453],{"type":22,"value":448},{"type":16,"tag":24,"props":455,"children":456},{},[457],{"type":16,"tag":458,"props":459,"children":460},"em",{},[461],{"type":22,"value":462},"(Замініть на значення від вашого хостера)",{"type":16,"tag":24,"props":464,"children":465},{},[466,471],{"type":16,"tag":56,"props":467,"children":468},{},[469],{"type":22,"value":470},"DKIM",{"type":22,"value":472}," — зазвичай налаштовується через панель керування хостингом. Хостер надає TXT-запис, який потрібно додати в DNS.",{"type":16,"tag":24,"props":474,"children":475},{},[476,481,483,489],{"type":16,"tag":56,"props":477,"children":478},{},[479],{"type":22,"value":480},"DMARC",{"type":22,"value":482}," — додайте TXT-запис для піддомену ",{"type"