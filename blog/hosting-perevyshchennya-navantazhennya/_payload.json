[{"data":1,"prerenderedAt":830},["ShallowReactive",2],{"blog-\u002Fblog\u002Fhosting-perevyshchennya-navantazhennya":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"image":11,"body":12,"_type":824,"_id":825,"_source":826,"_file":827,"_stem":828,"_extension":829},"\u002Fblog\u002Fhosting-perevyshchennya-navantazhennya","blog",false,"","Хостинг попереджає про перевищення навантаження: що робити і як оптимізувати сайт","Отримали від хостера лист про перевищення процесорних хвилин? Розбираємо причини високого навантаження на сервер, як знайти «пожирачів» ресурсів та оптимізувати сайт на WordPress, OpenCart чи Laravel.","2026-07-29","\u002Fog-image.png",{"type":13,"children":14,"toc":796},"root",[15,23,29,34,41,54,64,89,94,100,107,112,120,147,153,158,166,189,195,200,206,211,217,230,236,241,247,253,258,264,269,275,288,300,306,312,343,353,379,385,435,441,446,452,465,473,486,497,503,559,565,577,589,600,605,614,620,625,674,679,712,718,756,783],{"type":16,"tag":17,"props":18,"children":20},"element","h1",{"id":19},"хостинг-попереджає-про-перевищення-навантаження-що-робити-і-як-оптимізувати-сайт",[21],{"type":22,"value":8},"text",{"type":16,"tag":24,"props":25,"children":26},"p",{},[27],{"type":22,"value":28},"«Ваш хостинг-акаунт перевищив допустиме навантаження на сервер. Використано 127 процесорних хвилин з допустимих 100». Ось такий лист від хостера може перетворити спокійний ранок на біль голови. А якщо не відреагувати — сайт просто обмежать, і він почне «падати» у найневідповідніший момент.",{"type":16,"tag":24,"props":30,"children":31},{},[32],{"type":22,"value":33},"Ця проблема стосується тисяч власників сайтів на шаред-хостингу (Hosting Ukraine, Cityhost, FreeHost та інших). Давайте розберемося, чому це стається і як вирішити проблему без переплат за дорожчий тариф.",{"type":16,"tag":35,"props":36,"children":38},"h2",{"id":37},"що-таке-процесорні-хвилини-і-чому-вони-обмежені",[39],{"type":22,"value":40},"Що таке «процесорні хвилини» і чому вони обмежені?",{"type":16,"tag":24,"props":42,"children":43},{},[44,46,52],{"type":22,"value":45},"На віртуальному (шаред) хостингу ваш сайт ділить ресурси одного фізичного сервера з сотнями інших сайтів. Щоб один «жадібний» сайт не з'їв усі ресурси і не «поклав» сервер для всіх, хостери встановлюють ліміти — зазвичай ",{"type":16,"tag":47,"props":48,"children":49},"strong",{},[50],{"type":22,"value":51},"100 процесорних хвилин на добу",{"type":22,"value":53},".",{"type":16,"tag":24,"props":55,"children":56},{},[57,62],{"type":16,"tag":47,"props":58,"children":59},{},[60],{"type":22,"value":61},"Процесорна хвилина",{"type":22,"value":63}," — це одиниця обчислювальної потужності. Щоразу, коли відвідувач відкриває сторінку вашого сайту, сервер витрачає процесорний час на:",{"type":16,"tag":65,"props":66,"children":67},"ul",{},[68,74,79,84],{"type":16,"tag":69,"props":70,"children":71},"li",{},[72],{"type":22,"value":73},"Виконання PHP-скриптів",{"type":16,"tag":69,"props":75,"children":76},{},[77],{"type":22,"value":78},"Запити до бази даних MySQL",{"type":16,"tag":69,"props":80,"children":81},{},[82],{"type":22,"value":83},"Генерацію HTML-сторінки",{"type":16,"tag":69,"props":85,"children":86},{},[87],{"type":22,"value":88},"Обробку зображень та файлів",{"type":16,"tag":24,"props":90,"children":91},{},[92],{"type":22,"value":93},"Якщо сайт неоптимізований, навіть 200–300 відвідувачів на день можуть вичерпати ліміт. А оптимізований сайт може обслуговувати тисячі без жодних проблем.",{"type":16,"tag":35,"props":95,"children":97},{"id":96},"головні-причини-перевищення-навантаження",[98],{"type":22,"value":99},"Головні причини перевищення навантаження",{"type":16,"tag":101,"props":102,"children":104},"h3",{"id":103},"_1-неоптимізовані-запити-до-бази-даних",[105],{"type":22,"value":106},"1. Неоптимізовані запити до бази даних",{"type":16,"tag":24,"props":108,"children":109},{},[110],{"type":22,"value":111},"Це причина №1. CMS (особливо WordPress з купою плагінів) може робити десятки і навіть сотні запитів до бази даних на кожне завантаження сторінки. Якщо запити «важкі» (без індексів, з повним скануванням таблиць) — сервер витрачає на них колосальну кількість процесорного часу.",{"type":16,"tag":24,"props":113,"children":114},{},[115],{"type":16,"tag":47,"props":116,"children":117},{},[118],{"type":22,"value":119},"Типові ситуації:",{"type":16,"tag":65,"props":121,"children":122},{},[123,128,133],{"type":16,"tag":69,"props":124,"children":125},{},[126],{"type":22,"value":127},"Інтернет-магазин з 10 000+ товарів без оптимізації запитів",{"type":16,"tag":69,"props":129,"children":130},{},[131],{"type":22,"value":132},"Плагіни, які зберігають логи в базу і ніколи їх не чистять",{"type":16,"tag":69,"props":134,"children":135},{},[136,138,145],{"type":22,"value":137},"Розрослася таблиця ",{"type":16,"tag":139,"props":140,"children":142},"code",{"className":141},[],[143],{"type":22,"value":144},"wp_options",{"type":22,"value":146}," з автозавантаженням тисяч записів",{"type":16,"tag":101,"props":148,"children":150},{"id":149},"_2-забагато-плагінів-wordpress",[151],{"type":22,"value":152},"2. Забагато плагінів (WordPress)",{"type":16,"tag":24,"props":154,"children":155},{},[156],{"type":22,"value":157},"Кожен плагін — це додатковий PHP-код, який виконується при кожному завантаженні. 30–40 активних плагінів — типова картина для WordPress-сайту, який «тормозить».",{"type":16,"tag":24,"props":159,"children":160},{},[161],{"type":16,"tag":47,"props":162,"children":163},{},[164],{"type":22,"value":165},"Особливо «тяжкі» категорії плагінів:",{"type":16,"tag":65,"props":167,"children":168},{},[169,174,179,184],{"type":16,"tag":69,"props":170,"children":171},{},[172],{"type":22,"value":173},"Плагіни безпеки (Wordfence, Sucuri) — сканують кожен запит",{"type":16,"tag":69,"props":175,"children":176},{},[177],{"type":22,"value":178},"Статистика та аналітика на стороні сервера",{"type":16,"tag":69,"props":180,"children":181},{},[182],{"type":22,"value":183},"Плагіни бекапів, які працюють у фоновому режимі",{"type":16,"tag":69,"props":185,"children":186},{},[187],{"type":22,"value":188},"SEO-плагіни з генерацією карти сайту (sitemap) «на льоту»",{"type":16,"tag":101,"props":190,"children":192},{"id":191},"_3-відсутність-кешування",[193],{"type":22,"value":194},"3. Відсутність кешування",{"type":16,"tag":24,"props":196,"children":197},{},[198],{"type":22,"value":199},"Без кешування сервер генерує кожну сторінку заново для кожного відвідувача. Тобто, якщо 100 людей за годину відкрили вашу головну сторінку — сервер 100 разів виконав ті самі PHP-скрипти та SQL-запити.",{"type":16,"tag":101,"props":201,"children":203},{"id":202},"_4-бот-трафік-і-сканування",[204],{"type":22,"value":205},"4. Бот-трафік і сканування",{"type":16,"tag":24,"props":207,"children":208},{},[209],{"type":22,"value":210},"Величезна кількість ботів щодня сканує сайти: пошукові роботи (Googlebot, Bingbot), SEO-інструменти (Ahrefs, SEMrush), спам-боти, сканери вразливостей. Кожен запит бота — це навантаження на сервер, і бот не використовує кеш.",{"type":16,"tag":101,"props":212,"children":214},{"id":213},"_5-cron-задачі-та-фонові-процеси",[215],{"type":22,"value":216},"5. Cron-задачі та фонові процеси",{"type":16,"tag":24,"props":218,"children":219},{},[220,222,228],{"type":22,"value":221},"WordPress має вбудований планувальник ",{"type":16,"tag":139,"props":223,"children":225},{"className":224},[],[226],{"type":22,"value":227},"wp-cron",{"type":22,"value":229},", який запускається при кожному відвідуванні сайту. Якщо у вас налаштовані автоматичні бекапи, синхронізація товарів, імпорт прайс-листів — вони можуть «з'їдати» процесорні хвилини непомітно.",{"type":16,"tag":101,"props":231,"children":233},{"id":232},"_6-важкі-зображення-без-оптимізації",[234],{"type":22,"value":235},"6. Важкі зображення без оптимізації",{"type":16,"tag":24,"props":237,"children":238},{},[239],{"type":22,"value":240},"Сервер витрачає ресурси на обробку зображень: створення мініатюр, конвертацію у WebP, динамічне масштабування. Якщо ви завантажуєте фото з камери (5–10 МБ кожне) без попередньої оптимізації — це серйозне навантаження.",{"type":16,"tag":35,"props":242,"children":244},{"id":243},"як-знайти-причину-діагностика",[245],{"type":22,"value":246},"Як знайти причину: діагностика",{"type":16,"tag":101,"props":248,"children":250},{"id":249},"перевірте-статистику-хостингу",[251],{"type":22,"value":252},"Перевірте статистику хостингу",{"type":16,"tag":24,"props":254,"children":255},{},[256],{"type":22,"value":257},"Більшість хостерів надають графіки використання ресурсів у панелі керування (cPanel → Resource Usage, або аналогічний розділ). Подивіться, в які години піки навантаження — це підкаже, що їх спричиняє.",{"type":16,"tag":101,"props":259,"children":261},{"id":260},"перевірте-повільні-запити-mysql",[262],{"type":22,"value":263},"Перевірте повільні запити MySQL",{"type":16,"tag":24,"props":265,"children":266},{},[267],{"type":22,"value":268},"У cPanel є розділ «Slow Query Log» або попросіть хостера його увімкнути. Він покаже SQL-запити, які виконуються довше 1 секунди — саме вони «з'їдають» процесорні хвилини.",{"type":16,"tag":101,"props":270,"children":272},{"id":271},"перевірте-логи-доступу",[273],{"type":22,"value":274},"Перевірте логи доступу",{"type":16,"tag":24,"props":276,"children":277},{},[278,280,286],{"type":22,"value":279},"Файл ",{"type":16,"tag":139,"props":281,"children":283},{"className":282},[],[284],{"type":22,"value":285},"access.log",{"type":22,"value":287}," покаже всі запити до вашого сайту. Якщо ви бачите тисячі запитів від одного IP або бота — це причина.",{"type":16,"tag":289,"props":290,"children":295},"pre",{"code":291,"language":292,"meta":7,"className":293},"# Подивитися топ-10 IP за кількістю запитів\nawk '{print $1}' access.log | sort | uniq -c | sort -rn | head -10\n","bash",[294],"language-bash",[296],{"type":16,"tag":139,"props":297,"children":298},{"__ignoreMap":7},[299],{"type":22,"value":291},{"type":16,"tag":35,"props":301,"children":303},{"id":302},"як-знизити-навантаження-покрокова-інструкція",[304],{"type":22,"value":305},"Як знизити навантаження: покрокова інструкція",{"type":16,"tag":101,"props":307,"children":309},{"id":308},"крок-1-встановіть-кешування",[310],{"type":22,"value":311},"Крок 1. Встановіть кешування",{"type":16,"tag":24,"props":313,"children":314},{},[315,320,322,327,329,334,336,341],{"type":16,"tag":47,"props":316,"children":317},{},[318],{"type":22,"value":319},"WordPress:",{"type":22,"value":321},"\nВстановіть плагін ",{"type":16,"tag":47,"props":323,"children":324},{},[325],{"type":22,"value":326},"LiteSpeed Cache",{"type":22,"value":328}," (якщо хостинг на LiteSpeed) або ",{"type":16,"tag":47,"props":330,"children":331},{},[332],{"type":22,"value":333},"WP Super Cache",{"type":22,"value":335}," \u002F ",{"type":16,"tag":47,"props":337,"children":338},{},[339],{"type":22,"value":340},"W3 Total Cache",{"type":22,"value":342},". Кешування зберігає готову HTML-сторінку і віддає її наступним відвідувачам без виконання PHP та SQL-запитів.",{"type":16,"tag":24,"props":344,"children":345},{},[346,351],{"type":16,"tag":47,"props":347,"children":348},{},[349],{"type":22,"value":350},"OpenCart:",{"type":22,"value":352},"\nУвімкніть вбудоване кешування в налаштуваннях системи та OPcache на сервері.",{"type":16,"tag":24,"props":354,"children":355},{},[356,361,363,369,371,377],{"type":16,"tag":47,"props":357,"children":358},{},[359],{"type":22,"value":360},"Laravel:",{"type":22,"value":362},"\nВикористовуйте ",{"type":16,"tag":139,"props":364,"children":366},{"className":365},[],[367],{"type":22,"value":368},"php artisan config:cache",{"type":22,"value":370},", ",{"type":16,"tag":139,"props":372,"children":374},{"className":373},[],[375],{"type":22,"value":376},"php artisan route:cache",{"type":22,"value":378}," та кешування запитів через Redis або Memcached.",{"type":16,"tag":101,"props":380,"children":382},{"id":38