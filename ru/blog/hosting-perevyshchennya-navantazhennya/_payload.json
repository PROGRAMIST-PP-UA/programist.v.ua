[{"data":1,"prerenderedAt":830},["ShallowReactive",2],{"blog-\u002Fru\u002Fblog\u002Fhosting-perevyshchennya-navantazhennya":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"image":11,"body":12,"_type":824,"_id":825,"_source":826,"_file":827,"_stem":828,"_extension":829},"\u002Fru\u002Fblog\u002Fhosting-perevyshchennya-navantazhennya","blog",false,"","Хостинг предупреждает о превышении нагрузки: что делать и как оптимизировать сайт","Получили от хостера письмо о превышении процессорных минут? Разбираем причины высокой нагрузки на сервер, как найти «пожирателей» ресурсов и оптимизировать сайт на WordPress, OpenCart или Laravel.","2026-07-29","\u002Fog-image.png",{"type":13,"children":14,"toc":796},"root",[15,23,29,34,41,54,64,89,94,100,107,112,120,147,153,158,166,189,195,200,206,211,217,230,236,241,247,253,258,264,269,275,288,300,306,312,343,353,379,385,435,441,446,452,465,473,486,497,503,559,565,577,589,600,605,614,620,625,674,679,712,718,756,783],{"type":16,"tag":17,"props":18,"children":20},"element","h1",{"id":19},"хостинг-предупреждает-о-превышении-нагрузки-что-делать-и-как-оптимизировать-сайт",[21],{"type":22,"value":8},"text",{"type":16,"tag":24,"props":25,"children":26},"p",{},[27],{"type":22,"value":28},"«Ваш хостинг-аккаунт превысил допустимую нагрузку на сервер. Использовано 127 процессорных минут из допустимых 100». Вот такое письмо от хостера может превратить спокойное утро в головную боль. А если не отреагировать — сайт просто ограничат, и он начнёт «падать» в самый неподходящий момент.",{"type":16,"tag":24,"props":30,"children":31},{},[32],{"type":22,"value":33},"Эта проблема касается тысяч владельцев сайтов на шаред-хостинге (Hosting Ukraine, Cityhost, FreeHost и других). Давайте разберёмся, почему это происходит и как решить проблему без переплат за более дорогой тариф.",{"type":16,"tag":35,"props":36,"children":38},"h2",{"id":37},"что-такое-процессорные-минуты-и-почему-они-ограничены",[39],{"type":22,"value":40},"Что такое «процессорные минуты» и почему они ограничены?",{"type":16,"tag":24,"props":42,"children":43},{},[44,46,52],{"type":22,"value":45},"На виртуальном (шаред) хостинге ваш сайт делит ресурсы одного физического сервера с сотнями других сайтов. Чтобы один «жадный» сайт не съел все ресурсы и не «положил» сервер для всех, хостеры устанавливают лимиты — обычно ",{"type":16,"tag":47,"props":48,"children":49},"strong",{},[50],{"type":22,"value":51},"100 процессорных минут в сутки",{"type":22,"value":53},".",{"type":16,"tag":24,"props":55,"children":56},{},[57,62],{"type":16,"tag":47,"props":58,"children":59},{},[60],{"type":22,"value":61},"Процессорная минута",{"type":22,"value":63}," — это единица вычислительной мощности. Каждый раз, когда посетитель открывает страницу вашего сайта, сервер тратит процессорное время на:",{"type":16,"tag":65,"props":66,"children":67},"ul",{},[68,74,79,84],{"type":16,"tag":69,"props":70,"children":71},"li",{},[72],{"type":22,"value":73},"Выполнение PHP-скриптов",{"type":16,"tag":69,"props":75,"children":76},{},[77],{"type":22,"value":78},"Запросы к базе данных MySQL",{"type":16,"tag":69,"props":80,"children":81},{},[82],{"type":22,"value":83},"Генерацию HTML-страницы",{"type":16,"tag":69,"props":85,"children":86},{},[87],{"type":22,"value":88},"Обработку изображений и файлов",{"type":16,"tag":24,"props":90,"children":91},{},[92],{"type":22,"value":93},"Если сайт неоптимизирован, даже 200–300 посетителей в день могут исчерпать лимит. А оптимизированный сайт может обслуживать тысячи без каких-либо проблем.",{"type":16,"tag":35,"props":95,"children":97},{"id":96},"главные-причины-превышения-нагрузки",[98],{"type":22,"value":99},"Главные причины превышения нагрузки",{"type":16,"tag":101,"props":102,"children":104},"h3",{"id":103},"_1-неоптимизированные-запросы-к-базе-данных",[105],{"type":22,"value":106},"1. Неоптимизированные запросы к базе данных",{"type":16,"tag":24,"props":108,"children":109},{},[110],{"type":22,"value":111},"Это причина №1. CMS (особенно WordPress с кучей плагинов) может выполнять десятки и даже сотни запросов к базе данных при каждой загрузке страницы. Если запросы «тяжёлые» (без индексов, с полным сканированием таблиц) — сервер тратит на них колоссальное количество процессорного времени.",{"type":16,"tag":24,"props":113,"children":114},{},[115],{"type":16,"tag":47,"props":116,"children":117},{},[118],{"type":22,"value":119},"Типичные ситуации:",{"type":16,"tag":65,"props":121,"children":122},{},[123,128,133],{"type":16,"tag":69,"props":124,"children":125},{},[126],{"type":22,"value":127},"Интернет-магазин с 10 000+ товаров без оптимизации запросов",{"type":16,"tag":69,"props":129,"children":130},{},[131],{"type":22,"value":132},"Плагины, которые хранят логи в базу и никогда их не чистят",{"type":16,"tag":69,"props":134,"children":135},{},[136,138,145],{"type":22,"value":137},"Разросшаяся таблица ",{"type":16,"tag":139,"props":140,"children":142},"code",{"className":141},[],[143],{"type":22,"value":144},"wp_options",{"type":22,"value":146}," с автозагрузкой тысяч записей",{"type":16,"tag":101,"props":148,"children":150},{"id":149},"_2-слишком-много-плагинов-wordpress",[151],{"type":22,"value":152},"2. Слишком много плагинов (WordPress)",{"type":16,"tag":24,"props":154,"children":155},{},[156],{"type":22,"value":157},"Каждый плагин — это дополнительный PHP-код, который выполняется при каждой загрузке. 30–40 активных плагинов — типичная картина для WordPress-сайта, который «тормозит».",{"type":16,"tag":24,"props":159,"children":160},{},[161],{"type":16,"tag":47,"props":162,"children":163},{},[164],{"type":22,"value":165},"Особенно «тяжёлые» категории плагинов:",{"type":16,"tag":65,"props":167,"children":168},{},[169,174,179,184],{"type":16,"tag":69,"props":170,"children":171},{},[172],{"type":22,"value":173},"Плагины безопасности (Wordfence, Sucuri) — сканируют каждый запрос",{"type":16,"tag":69,"props":175,"children":176},{},[177],{"type":22,"value":178},"Статистика и аналитика на стороне сервера",{"type":16,"tag":69,"props":180,"children":181},{},[182],{"type":22,"value":183},"Плагины бэкапов, работающие в фоновом режиме",{"type":16,"tag":69,"props":185,"children":186},{},[187],{"type":22,"value":188},"SEO-плагины с генерацией карты сайта (sitemap) «на лету»",{"type":16,"tag":101,"props":190,"children":192},{"id":191},"_3-отсутствие-кеширования",[193],{"type":22,"value":194},"3. Отсутствие кеширования",{"type":16,"tag":24,"props":196,"children":197},{},[198],{"type":22,"value":199},"Без кеширования сервер генерирует каждую страницу заново для каждого посетителя. То есть, если 100 человек за час открыли вашу главную страницу — сервер 100 раз выполнил одни и те же PHP-скрипты и SQL-запросы.",{"type":16,"tag":101,"props":201,"children":203},{"id":202},"_4-бот-трафик-и-сканирование",[204],{"type":22,"value":205},"4. Бот-трафик и сканирование",{"type":16,"tag":24,"props":207,"children":208},{},[209],{"type":22,"value":210},"Огромное количество ботов ежедневно сканирует сайты: поисковые роботы (Googlebot, Bingbot), SEO-инструменты (Ahrefs, SEMrush), спам-боты, сканеры уязвимостей. Каждый запрос бота — это нагрузка на сервер, и бот не использует кеш.",{"type":16,"tag":101,"props":212,"children":214},{"id":213},"_5-cron-задачи-и-фоновые-процессы",[215],{"type":22,"value":216},"5. Cron-задачи и фоновые процессы",{"type":16,"tag":24,"props":218,"children":219},{},[220,222,228],{"type":22,"value":221},"WordPress имеет встроенный планировщик ",{"type":16,"tag":139,"props":223,"children":225},{"className":224},[],[226],{"type":22,"value":227},"wp-cron",{"type":22,"value":229},", который запускается при каждом посещении сайта. Если у вас настроены автоматические бэкапы, синхронизация товаров, импорт прайс-листов — они могут «поедать» процессорные минуты незаметно.",{"type":16,"tag":101,"props":231,"children":233},{"id":232},"_6-тяжёлые-изображения-без-оптимизации",[234],{"type":22,"value":235},"6. Тяжёлые изображения без оптимизации",{"type":16,"tag":24,"props":237,"children":238},{},[239],{"type":22,"value":240},"Сервер тратит ресурсы на обработку изображений: создание миниатюр, конвертацию в WebP, динамическое масштабирование. Если вы загружаете фото с камеры (5–10 МБ каждое) без предварительной оптимизации — это серьёзная нагрузка.",{"type":16,"tag":35,"props":242,"children":244},{"id":243},"как-найти-причину-диагностика",[245],{"type":22,"value":246},"Как найти причину: диагностика",{"type":16,"tag":101,"props":248,"children":250},{"id":249},"проверьте-статистику-хостинга",[251],{"type":22,"value":252},"Проверьте статистику хостинга",{"type":16,"tag":24,"props":254,"children":255},{},[256],{"type":22,"value":257},"Большинство хостеров предоставляют графики использования ресурсов в панели управления (cPanel → Resource Usage, или аналогичный раздел). Посмотрите, в какие часы пики нагрузки — это подскажет, что их вызывает.",{"type":16,"tag":101,"props":259,"children":261},{"id":260},"проверьте-медленные-запросы-mysql",[262],{"type":22,"value":263},"Проверьте медленные запросы MySQL",{"type":16,"tag":24,"props":265,"children":266},{},[267],{"type":22,"value":268},"В cPanel есть раздел «Slow Query Log» или попросите хостера его включить. Он покажет SQL-запросы, которые выполняются дольше 1 секунды — именно они «съедают» процессорные минуты.",{"type":16,"tag":101,"props":270,"children":272},{"id":271},"проверьте-логи-доступа",[273],{"type":22,"value":274},"Проверьте логи доступа",{"type":16,"tag":24,"props":276,"children":277},{},[278,280,286],{"type":22,"value":279},"Файл ",{"type":16,"tag":139,"props":281,"children":283},{"className":282},[],[284],{"type":22,"value":285},"access.log",{"type":22,"value":287}," покажет все запросы к вашему сайту. Если вы видите тысячи запросов от одного IP или бота — это причина.",{"type":16,"tag":289,"props":290,"children":295},"pre",{"code":291,"language":292,"meta":7,"className":293},"# Посмотреть топ-10 IP по количеству запросов\nawk '{print $1}' access.log | sort | uniq -c | sort -rn | head -10\n","bash",[294],"language-bash",[296],{"type":16,"tag":139,"props":297,"children":298},{"__ignoreMap":7},[299],{"type":22,"value":291},{"type":16,"tag":35,"props":301,"children":303},{"id":302},"как-снизить-нагрузку-пошаговая-инструкция",[304],{"type":22,"value":305},"Как снизить нагрузку: пошаговая инструкция",{"type":16,"tag":101,"props":307,"children":309},{"id":308},"шаг-1-установите-кеширование",[310],{"type":22,"value":311},"Шаг 1. Установите кеширование",{"type":16,"tag":24,"props":313,"children":314},{},[315,320,322,327,329,334,336,341],{"type":16,"tag":47,"props":316,"children":317},{},[318],{"type":22,"value":319},"WordPress:",{"type":22,"value":321},"\nУстановите плагин ",{"type":16,"tag":47,"props":323,"children":324},{},[325],{"type":22,"value":326},"LiteSpeed Cache",{"type":22,"value":328}," (если хостинг на LiteSpeed) или ",{"type":16,"tag":47,"props":330,"children":331},{},[332],{"type":22,"value":333},"WP Super Cache",{"type":22,"value":335}," \u002F ",{"type":16,"tag":47,"props":337,"children":338},{},[339],{"type":22,"value":340},"W3 Total Cache",{"type":22,"value":342},". Кеширование сохраняет готовую HTML-страницу и отдаёт её следующим посетителям без выполнения PHP и SQL-запросов.",{"type":16,"tag":24,"props":344,"children":345},{},[346,351],{"type":16,"tag":47,"props":347,"children":348},{},[349],{"type":22,"value":350},"OpenCart:",{"type":22,"value":352},"\nВключите встроенное кеширование в настройках системы и OPcache на сервере.",{"type":16,"tag":24,"props":354,"children":355},{},[356,361,363,369,371,377],{"type":16,"tag":47,"props":357,"children":358},{},[359],{"type":22,"value":360},"Laravel:",{"type":22,"value":362},"\nИспользуйте ",{"type":16,"tag":139,"props":364,"children":366},{"className":365},[],[367],{"type":22,"value":368},"php artisan config:cache",{"type":22,"value":370},", ",{"type":16,"tag":139,"props":372,"children":374},{"className":373},[],[375],{"type":22,"value":376},"php artisan route:cache",{"type":22,"value":378}," и кеширование запросов через Redis или Memcached.",{"type":16,"tag":101,"props":380,"children":382},{"id":381},"шаг-2-оптимизируйте-базу-данных",[383],{"type":22,"value":384},"Шаг 2. Оптимизируйте базу данных",{"type":16,"tag":65,"props":386,"children":387},{},[388,405,415,425],{"type":16,"tag":69,"props":389,"children":390},{},[391,396,398,403],{"type":16,"tag":47,"props":392,"children":393},{},[394],{"type":22,"value":395},"Удалите ревизии постов",{"type":22,"value":397}," (WordPress хранит до 100 версий каждого поста). Плагин ",{"type":16,"tag":47,"props":399,"children":400},{},[401],{"type":22,"value":402},"WP-Optimize",{"type":22,"value":404}," сделает это автоматически.",{"type":16,"tag":69,"props":406,"children":407},{},[408,413],{"type":16,"tag":47,"props":409,"children":410},{},[411],{"type":22,"value":412},"Очистите таблицу wp_options",{"type":22,"value":414}," от записей деактивированных плагинов.",{"type":16,"tag":69,"props":416,"children":417},{},[418,423],{"type":16,"tag":47,"props":419,"children":420},{},[421],{"type":22,"value":422},"Добавьте индексы",{"type":22,"value":424}," к наиболее нагруженным таблицам (если имеете опыт в SQL).",{"type":16,"tag":69,"props":426,"children":427},{},[428,433],{"type":16,"tag":47,"props":429,"children":430},{},[431],{"type":22,"value":432},"Оптимизируйте таблицы",{"type":22,"value":434}," через phpMyAdmin → выбрать все таблицы → «Оптимизировать».",{"type":16,"tag":101,"props":436,"children":438},{"id":437},"шаг-3-уберите-лишние-плагины",[439],{"type":22,"value":440},"Шаг 3. Уберите лишние плагины",{"type":16,"tag":24,"props":442,"children":443},{},[444],{"type":22,"value":445},"Проведите аудит плагинов: деактивируйте по одному и наблюдайте за нагрузкой. Часто 2–3 плагина ответственны за 80% потребления ресурсов. Замените «тяжёлые» плагины на лёгкие аналоги или встроенный функционал темы.",{"type":16,"tag":101,"props":447,"children":449},{"id":448},"шаг-4-ограничьте-ботов",[450],{"type":22