[{"data":1,"prerenderedAt":672},["ShallowReactive",2],{"blog-\u002Fru\u002Fblog\u002Fhosting-blokuye-poshtu-z-saytu":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"image":11,"body":12,"_type":666,"_id":667,"_source":668,"_file":669,"_stem":670,"_extension":671},"\u002Fru\u002Fblog\u002Fhosting-blokuye-poshtu-z-saytu","blog",false,"","Хостинг блокирует почту с сайта: почему письма не отправляются и как это исправить","Получили от хостинга уведомление о некорректных адресах отправителей? Разбираем, почему хостинг блокирует почту с вашего сайта, как правильно настроить отправку писем через SMTP и не попадать в спам.","2026-07-29","\u002Fog-image.png",{"type":13,"children":14,"toc":647},"root",[15,23,29,34,41,63,90,100,106,113,126,132,137,149,162,168,181,187,192,198,204,209,235,241,258,266,271,281,291,299,308,314,332,349,406,416,425,431,436,446,454,463,473,491,499,504,510,570,576,609,634],{"type":16,"tag":17,"props":18,"children":20},"element","h1",{"id":19},"хостинг-блокирует-почту-с-сайта-почему-письма-не-отправляются-и-как-это-исправить",[21],{"type":22,"value":8},"text",{"type":16,"tag":24,"props":25,"children":26},"p",{},[27],{"type":22,"value":28},"Однажды утром вы получаете от хостера тревожное письмо: «С вашего хостинг-аккаунта зафиксированы попытки отправки писем с некорректных адресов отправителей». Форма обратной связи на сайте перестала работать, заявки от клиентов не доходят, а вы даже не знаете, с какого момента это началось. Знакомая ситуация? Вы не одни — эта проблема массово возникает у владельцев сайтов на WordPress, OpenCart, Laravel и других CMS.",{"type":16,"tag":24,"props":30,"children":31},{},[32],{"type":22,"value":33},"Давайте разберёмся, почему это происходит и как исправить раз и навсегда.",{"type":16,"tag":35,"props":36,"children":38},"h2",{"id":37},"суть-проблемы-что-именно-блокирует-хостинг",[39],{"type":22,"value":40},"Суть проблемы: что именно блокирует хостинг?",{"type":16,"tag":24,"props":42,"children":43},{},[44,46,53,55,61],{"type":22,"value":45},"Когда кто-то оставляет заявку на вашем сайте, CMS формирует письмо и отправляет его через встроенную функцию ",{"type":16,"tag":47,"props":48,"children":50},"code",{"className":49},[],[51],{"type":22,"value":52},"mail()",{"type":22,"value":54},". И тут начинается проблема: сайт подставляет адрес отправителя, который ",{"type":16,"tag":56,"props":57,"children":58},"strong",{},[59],{"type":22,"value":60},"не принадлежит вашему хостингу",{"type":22,"value":62},".",{"type":16,"tag":24,"props":64,"children":65},{},[66,68,74,76,81,83,88],{"type":22,"value":67},"Например, клиент оставил заявку через форму, указав свою почту ",{"type":16,"tag":47,"props":69,"children":71},{"className":70},[],[72],{"type":22,"value":73},"ivan@gmail.com",{"type":22,"value":75},". Ваш сайт берёт этот адрес и пытается отправить письмо ",{"type":16,"tag":56,"props":77,"children":78},{},[79],{"type":22,"value":80},"от имени",{"type":22,"value":82}," ",{"type":16,"tag":47,"props":84,"children":86},{"className":85},[],[87],{"type":22,"value":73},{"type":22,"value":89},". Но ваш хостинг — это не Gmail. Он не имеет права отправлять письма от имени чужого домена.",{"type":16,"tag":24,"props":91,"children":92},{},[93,98],{"type":16,"tag":56,"props":94,"children":95},{},[96],{"type":22,"value":97},"Результат:",{"type":22,"value":99}," хостер блокирует такие письма, а популярные почтовые сервисы (Gmail, Outlook, Mail.ru) отклоняют их или отправляют в спам. Это ухудшает репутацию IP-адреса хостинга и создаёт проблемы всем его пользователям.",{"type":16,"tag":35,"props":101,"children":103},{"id":102},"типичные-причины-проблемы",[104],{"type":22,"value":105},"Типичные причины проблемы",{"type":16,"tag":107,"props":108,"children":110},"h3",{"id":109},"_1-адрес-отправителя-в-настройках-cms-email-клиента",[111],{"type":22,"value":112},"1. Адрес отправителя в настройках CMS = email клиента",{"type":16,"tag":24,"props":114,"children":115},{},[116,118,124],{"type":22,"value":117},"Самая распространённая ошибка. В WordPress-плагинах форм (Contact Form 7, WPForms) часто есть поле «From» (От кого). Если туда подставляется email посетителя сайта (например, через тег ",{"type":16,"tag":47,"props":119,"children":121},{"className":120},[],[122],{"type":22,"value":123},"[your-email]",{"type":22,"value":125},"), хостинг заблокирует отправку.",{"type":16,"tag":107,"props":127,"children":129},{"id":128},"_2-в-коде-сайта-жёстко-прописан-сторонний-адрес",[130],{"type":22,"value":131},"2. В коде сайта жёстко прописан сторонний адрес",{"type":16,"tag":24,"props":133,"children":134},{},[135],{"type":22,"value":136},"Некоторые разработчики прописывают в коде что-то вроде:",{"type":16,"tag":138,"props":139,"children":144},"pre",{"code":140,"language":141,"meta":7,"className":142},"mail($to, $subject, $message, \"From: info@gmail.com\");\n","php",[143],"language-php",[145],{"type":16,"tag":47,"props":146,"children":147},{"__ignoreMap":7},[148],{"type":22,"value":140},{"type":16,"tag":24,"props":150,"children":151},{},[152,154,160],{"type":22,"value":153},"Адрес ",{"type":16,"tag":47,"props":155,"children":157},{"className":156},[],[158],{"type":22,"value":159},"info@gmail.com",{"type":22,"value":161}," — не ваш. Хостинг не позволит отправить письмо от имени Gmail.",{"type":16,"tag":107,"props":163,"children":165},{"id":164},"_3-не-создан-почтовый-ящик-на-хостинге",[166],{"type":22,"value":167},"3. Не создан почтовый ящик на хостинге",{"type":16,"tag":24,"props":169,"children":170},{},[171,173,179],{"type":22,"value":172},"Даже если вы указали ",{"type":16,"tag":47,"props":174,"children":176},{"className":175},[],[177],{"type":22,"value":178},"info@vash-domen.ua",{"type":22,"value":180}," в качестве отправителя, но не создали этот ящик в панели управления хостингом — письмо может быть заблокировано или попасть в спам, так как почтовые серверы не смогут подтвердить существование отправителя.",{"type":16,"tag":107,"props":182,"children":184},{"id":183},"_4-отсутствуют-dns-записи-spf-dkim-dmarc",[185],{"type":22,"value":186},"4. Отсутствуют DNS-записи SPF, DKIM, DMARC",{"type":16,"tag":24,"props":188,"children":189},{},[190],{"type":22,"value":191},"Без этих записей почтовые серверы получателей не могут проверить, имеет ли ваш хостинг право отправлять почту от имени вашего домена. Даже если письмо отправится — оно, скорее всего, попадёт в спам.",{"type":16,"tag":35,"props":193,"children":195},{"id":194},"как-исправить-пошаговая-инструкция",[196],{"type":22,"value":197},"Как исправить: пошаговая инструкция",{"type":16,"tag":107,"props":199,"children":201},{"id":200},"шаг-1-создайте-почтовый-ящик-на-хостинге",[202],{"type":22,"value":203},"Шаг 1. Создайте почтовый ящик на хостинге",{"type":16,"tag":24,"props":205,"children":206},{},[207],{"type":22,"value":208},"Зайдите в панель управления хостингом (cPanel, DirectAdmin, ISPmanager) и создайте почтовый ящик, например:",{"type":16,"tag":210,"props":211,"children":212},"ul",{},[213,225],{"type":16,"tag":214,"props":215,"children":216},"li",{},[217,223],{"type":16,"tag":47,"props":218,"children":220},{"className":219},[],[221],{"type":22,"value":222},"noreply@vash-domen.ua",{"type":22,"value":224}," — для автоматических уведомлений",{"type":16,"tag":214,"props":226,"children":227},{},[228,233],{"type":16,"tag":47,"props":229,"children":231},{"className":230},[],[232],{"type":22,"value":178},{"type":22,"value":234}," — для форм обратной связи",{"type":16,"tag":107,"props":236,"children":238},{"id":237},"шаг-2-измените-адрес-отправителя-в-cms",[239],{"type":22,"value":240},"Шаг 2. Измените адрес отправителя в CMS",{"type":16,"tag":24,"props":242,"children":243},{},[244,249,251,256],{"type":16,"tag":56,"props":245,"children":246},{},[247],{"type":22,"value":248},"WordPress (Contact Form 7):",{"type":22,"value":250},"\nПерейдите в настройки формы → вкладка «Письмо» → в поле «От» (From) замените ",{"type":16,"tag":47,"props":252,"children":254},{"className":253},[],[255],{"type":22,"value":123},{"type":22,"value":257}," на ваш ящик:",{"type":16,"tag":138,"props":259,"children":261},{"code":260},"info@vash-domen.ua\n",[262],{"type":16,"tag":47,"props":263,"children":264},{"__ignoreMap":7},[265],{"type":22,"value":260},{"type":16,"tag":24,"props":267,"children":268},{},[269],{"type":22,"value":270},"А email клиента подставьте в поле «Reply-To» (Ответить на), чтобы при нажатии «Ответить» письмо шло именно клиенту.",{"type":16,"tag":24,"props":272,"children":273},{},[274,279],{"type":16,"tag":56,"props":275,"children":276},{},[277],{"type":22,"value":278},"WordPress (WPForms \u002F Elementor Forms):",{"type":22,"value":280},"\nАналогично: в поле «From Email» укажите корпоративную почту, а email посетителя — только в «Reply-To».",{"type":16,"tag":24,"props":282,"children":283},{},[284,289],{"type":16,"tag":56,"props":285,"children":286},{},[287],{"type":22,"value":288},"OpenCart:",{"type":22,"value":290},"\nВ админ-панели: Система → Настройки → вкладка «Почта» → укажите ваш корпоративный адрес.",{"type":16,"tag":24,"props":292,"children":293},{},[294],{"type":16,"tag":56,"props":295,"children":296},{},[297],{"type":22,"value":298},"В собственном PHP-коде:",{"type":16,"tag":138,"props":300,"children":303},{"code":301,"language":141,"meta":7,"className":302},"\u002F\u002F ❌ Неправильно:\n$headers = \"From: \" . $_POST['email'];\n\n\u002F\u002F ✅ Правильно:\n$headers  = \"From: info@vash-domen.ua\\r\\n\";\n$headers .= \"Reply-To: \" . $_POST['email'];\n",[143],[304],{"type":16,"tag":47,"props":305,"children":306},{"__ignoreMap":7},[307],{"type":22,"value":301},{"type":16,"tag":107,"props":309,"children":311},{"id":310},"шаг-3-настройте-отправку-через-smtp-рекомендуется",[312],{"type":22,"value":313},"Шаг 3. Настройте отправку через SMTP (рекомендуется)",{"type":16,"tag":24,"props":315,"children":316},{},[317,319,324,326,331],{"type":22,"value":318},"Стандартная PHP-функция ",{"type":16,"tag":47,"props":320,"children":322},{"className":321},[],[323],{"type":22,"value":52},{"type":22,"value":325}," отправляет письма «напрямую» с сервера, без авторизации. Это ненадёжно и часто блокируется. Гораздо лучше — ",{"type":16,"tag":56,"props":327,"children":328},{},[329],{"type":22,"value":330},"отправлять почту через SMTP с авторизацией",{"type":22,"value":62},{"type":16,"tag":24,"props":333,"children":334},{},[335,340,342,347],{"type":16,"tag":56,"props":336,"children":337},{},[338],{"type":22,"value":339},"Для WordPress",{"type":22,"value":341}," установите плагин ",{"type":16,"tag":56,"props":343,"children":344},{},[345],{"type":22,"value":346},"WP Mail SMTP",{"type":22,"value":348}," и настройте:",{"type":16,"tag":210,"props":350,"children":351},{},[352,365,386,396,401],{"type":16,"tag":214,"props":353,"children":354},{},[355,357,363],{"type":22,"value":356},"SMTP-сервер: ",{"type":16,"tag":47,"props":358,"children":360},{"className":359},[],[361],{"type":22,"value":362},"mail.vash-domen.ua",{"type":22,"value":364}," (уточните у хостера)",{"type":16,"tag":214,"props":366,"children":367},{},[368,370,376,378,384],{"type":22,"value":369},"Порт: ",{"type":16,"tag":47,"props":371,"children":373},{"className":372},[],[374],{"type":22,"value":375},"465",{"type":22,"value":377}," (SSL) или ",{"type":16,"tag":47,"props":379,"children":381},{"className":380},[],[382],{"type":22,"value":383},"587",{"type":22,"value":385}," (TLS)",{"type":16,"tag":214,"props":387,"children":388},{},[389,391],{"type":22,"value":390},"Логин: ",{"type":16,"tag":47,"props":392,"children":394},{"className":393},[],[395],{"type":22,"value":178},{"type":16,"tag":214,"props":397,"children":398},{},[399],{"type":22,"value":400},"Пароль: пароль от этого ящика",{"type":16,"tag":214,"props":402,"children":403},{},[404],{"type":22,"value":405},"Шифрование: SSL или TLS",{"type":16,"tag":24,"props":407,"children":408},{},[409,414],{"type":16,"tag":56,"props":410,"children":411},{},[412],{"type":22,"value":413},"Для PHP \u002F Laravel:",{"type":22,"value":415},"\nИспользуйте библиотеку PHPMailer или встроенный Mail в Laravel:",{"type":16,"tag":138,"props":417,"children":420},{"code":418,"language":141,"meta":7,"className":419},"\u002F\u002F .env (Laravel)\nMAIL_MAILER=smtp\nMAIL_HOST=mail.vash-domen.ua\nMAIL_PORT=465\nMAIL_USERNAME=info@vash-domen.ua\nMAIL_PASSWORD=ваш_пароль\nMAIL_ENCRYPTION=ssl\nMAIL_FROM_ADDRESS=info@vash-domen.ua\n",[143],[421],{"type":16,"tag":47,"props":422,"children":423},{"__ignoreMap":7},[424],{"type":22,"value":418},{"type":16,"tag":107,"props":426,"children":428},{"id":427},"шаг-4-добавьте-dns-записи-spf-dkim-и-dmarc",[429],{"type":22,"value":430},"Шаг 4. Добавьте DNS-записи SPF, DKIM и DMARC",{"type":16,"tag":24,"props":432,"children":433},{},[434],{"type":22,"value":435},"Эти записи подтверждают почтовым серверам, что ваш хостинг имеет право отправлять почту от имени вашего домена.",{"type":16,"tag":24,"props":437,"children":438},{},[439,444],{"type":16,"tag":56,"props":440,"children":441},{},[442],{"type":22,"value":443},"SPF",{"type":22,"value":445}," — добавьте TXT-запись в DNS вашего домена:",{"type":16,"tag":138,"props":447,"children":449},{"code":448},"v=spf1 include:spf.hosting-ukraine.com.ua ~all\n",[450],{"type":16,"tag":47,"props":451,"children":452},{"__ignoreMap":7},[453],{"type":22,"value":448},{"type":16,"tag":24,"props":455,"children":456},{},[457],{"type":16,"tag":458,"props":459,"children":460},"em",{},[461],{"type":22,"value":462},"(Замените на значение от вашего хостера)",{"type":16,"tag":24,"props":464,"children":465},{},[466,471],{"type":16,"tag":56,"props":467,"children":468},{},[469],{"type":22,"value":470},"DKIM",{"type":22,"value":472}," — обычно настраивается через панель управления хостингом. Хостер предоставляет TXT-запись, которую нужно добавить в DNS.",{"type":16,"tag":24,"props":474,"children":475},{},[476,481,483,489],{"type":16,"tag":56,"props":477,"children":478},{},[479],{"type":22,"value":480},"DMARC",{"type":22,"value":482}," — добавьте TXT-запись для поддомена ",{"type":16,"tag":47,"props":484,"children":486},{"className":485},[],[487],{"type":22,"value":488},"_dmarc",{"type":22,"value":490},":",{"type":16,"tag":138,"props":492,"children":494},{"code":493},"v=DMARC1; p=none; rua=mailto:info@vash-domen.ua\n",[495],{"type":16,"tag":47,"props":496,"children":497},{"__ignoreMap":7},[498],{"type":22,"value":493},{"type":16,"tag":24,"props":500,"children":501},{},[502],{"type":22,"value":503},"Большинство хостеров (Hosting Ukraine, Cityhost, FreeHost) имеют инструкции по настройке этих записей в своей базе знаний.",{"type":16,"tag":35,"props":505,"children":507},{"id":506},"как-проверить-что-всё-работает",[508],{"type":22,"value":509},"Как проверить, что всё работает?",{"type":16,"tag":511,"props":512,"children":513},"ol",{},[514,524,534,553],{"type":16,"tag":214,"props":515,"children":516},{},[517,522],{"type":16,"tag":56,"props":518,"children":519},{},[520],{"type":22,"value":521},"Отправьте тестовое письмо",{"type":22,"value":523}," через форму на сайте на свою почту Gmail.",{"type":16,"tag":214,"props":525,"children":526},{},[527,532],{"type":16,"tag":56,"props":528,"children":529},{},[530],{"type":22,"value":531},"Проверьте папку «Спам»",{"type":22,"value":533}," — если письмо там, значит DNS-записи ещё не подтянулись или настроены некорректно.",{"type":16,"tag":214,"props":535,"children":536},{},[537,551],{"type":16,"tag":56,"props":538,"children":539},{},[540,542],{"type":22,"value":541},"Используйте сервис ",{"type":16,"tag":543,"props":544,"children":548},"a",{"href":545,"rel":546},"https:\u002F\u002Fwww.mail-tester.com\u002F",[547],"nofollow",[549],{"type":22,"value":550},"mail-tester.com",{"type":22,"value":552}," — он покажет оценку вашего письма от 1 до 10 и подскажет, что ещё нужно исправить.",{"type":16,"tag":214,"props":554,"children":555},{},[556,561,563,569],{"type":16,"tag":56,"props":557,"children":558},{},[559],{"type":22,"value":560},"Проверьте заголовки письма",{"type":22,"value":562}," — в Gmail нажмите «Показать оригинал» и убедитесь, что SPF, DKIM и DMARC имеют статус ",{"type":16,"tag":47,"props":564,"children":566},{"className":565},[],[567],{"type":22,"value":568},"PASS",{"type":22,"value":62},{"type":16,"tag":35,"props":571,"children":573},{"id":572},"итог-чек-лист-для-владельца-сайта",[574],{"type":22,"value":575},"Итог: чек-лист для владельца сайта",{"type":16,"tag":210,"props":577,"children":578},{},[579,584,589,594,599,604],{"type":16,"tag":214,"props":580,"children":581},{},[582],{"type":22,"value":583},"✅ На хостинге создан почтовый ящик для домена сайта",{"type":16,"tag":214,"props":585,"children":586},{},[587],{"type":22,"value":588},"✅ В CMS \u002F коде отправителем указана корпоративная почта (не gmail, не mail.ru)",{"type":16,"tag":214,"props":590,"children":591},{},[592],{"type":22,"value":593},"✅ Email клиента подставляется только в «Reply-To»",{"type":16,"tag":214,"props":595,"children":596},{},[597],{"type":22,"value":598},"✅ Письма отправляются через SMTP с авторизацией",{"type":16,"tag":214,"props":600,"children":601},{},[602],{"type":22,"value":603},"✅ В DNS домена добавлены записи SPF, DKIM, DMARC",{"type":16,"tag":214,"props":605,"children":606},{},[607],{"type":22,"value":608},"✅ Тестовое письмо приходит во «Входящие», а не в «Спам»",{"type":16,"tag":610,"props":611,"children":612},"blockquote",{},[613],{"type":16,"tag":24,"props":614,"children":615},{},[616,618,623,625,632],{"type":22,"value":617},"💡 ",{"type":16,"tag":56,"props":619,"children":620},{},[621],{"type":22,"value":622},"Совет:",{"type":22,"value":624}," На хостинге ",{"type":16,"tag":543,"props":626,"children":629},{"href":627,"rel":628},"https:\u002F\u002Fhostpro.apartner.pro",[547],[630],{"type":22,"value":631},"HostPro",{"type":22,"value":633}," почтовые серверы настроены профессионально, SPF и DKIM записи генерируются автоматически, а SMTP работает стабильно «из коробки». Если вы устали от проблем с почтой на текущем хостинге — попробуйте HostPro.",{"type":16,"tag":610,"props":635,"children":636},{},[637],{"type":16,"tag":24,"props":638,"children":639},{},[640,645],{"type":16,"tag":56,"props":641,"children":642},{},[643],{"type":22,"value":644},"Не хотите разбираться самостоятельно?",{"type":22,"value":646}," Я помогу настроить отправку почты с вашего сайта правильно: создам почтовые ящики, настрою SMTP, SPF, DKIM и DMARC, чтобы ваши письма всегда доходили до клиентов. Оставьте заявку — и забудьте о проблемах с почтой!",{"title":7,"searchDepth":648,"depth":648,"links":649},2,[650,651,658,664,665],{"id":37,"depth":648,"text":40},{"id":102,"depth":648,"text":105,"children":652},[653,655,656,657],{"id":109,"depth":654,"text":112},3,{"id":128,"depth":654,"text":131},{"id":164,"depth":654,"text":167},{"id":183,"depth":654,"text":186},{"id":194,"depth":648,"text":197,"children":659},[660,661,662,663],{"id":200,"depth":654,"text":203},{"id":237,"depth":654,"text":240},{"id":310,"depth":654,"text":313},{"id":427,"depth":654,"text":430},{"id":506,"depth":648,"text":509},{"id":572,"depth":648,"text":575},"markdown","content:ru:blog:hosting-blokuye-poshtu-z-saytu.md","content","ru\u002Fblog\u002Fhosting-blokuye-poshtu-z-saytu.md","ru\u002Fblog\u002Fhosting-blokuye-poshtu-z-saytu","md",1785336106175]