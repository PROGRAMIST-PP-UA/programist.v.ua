[{"data":1,"prerenderedAt":801},["ShallowReactive",2],{"blog-\u002Fru\u002Fblog\u002Fhosting-perevyshchennya-inodes":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"image":11,"body":12,"_type":795,"_id":796,"_source":797,"_file":798,"_stem":799,"_extension":800},"\u002Fru\u002Fblog\u002Fhosting-perevyshchennya-inodes","blog",false,"","Хостинг пишет о превышении inodes: что это такое и как освободить файлы на сервере","Получили уведомление от хостера о превышении лимита inodes? Разбираем, что такое иноды, почему они заканчиваются, как найти и удалить лишние файлы на WordPress, OpenCart и других CMS.","2026-07-29","\u002Fog-image.png",{"type":13,"children":14,"toc":767},"root",[15,23,29,36,54,65,73,128,140,146,153,165,177,183,195,201,240,246,251,257,293,299,304,310,316,321,327,339,345,372,378,384,394,404,421,431,437,442,491,503,509,514,537,543,552,558,567,572,578,606,612,686,692,697,715,727,754],{"type":16,"tag":17,"props":18,"children":20},"element","h1",{"id":19},"хостинг-пишет-о-превышении-inodes-что-это-такое-и-как-освободить-файлы-на-сервере",[21],{"type":22,"value":8},"text",{"type":16,"tag":24,"props":25,"children":26},"p",{},[27],{"type":22,"value":28},"Ещё один «подарок» от хостера в почтовый ящик: «Ваш хостинг-аккаунт превысил допустимое количество inodes». Сайт начинает работать с перебоями, нельзя загрузить новые файлы, а вы даже не понимаете, что такое эти загадочные «иноды». Эта проблема встречается не менее часто, чем превышение процессорных минут, и решается гораздо проще, чем кажется.",{"type":16,"tag":30,"props":31,"children":33},"h2",{"id":32},"что-такое-inodes-иноды",[34],{"type":22,"value":35},"Что такое inodes (иноды)?",{"type":16,"tag":24,"props":37,"children":38},{},[39,45,47,52],{"type":16,"tag":40,"props":41,"children":42},"strong",{},[43],{"type":22,"value":44},"Inode",{"type":22,"value":46}," — это запись в файловой системе сервера, которая создаётся для каждого файла и папки. Один файл = один inode. Одна папка = один inode. Это не про размер файлов, а про их ",{"type":16,"tag":40,"props":48,"children":49},{},[50],{"type":22,"value":51},"количество",{"type":22,"value":53},".",{"type":16,"tag":24,"props":55,"children":56},{},[57,59,64],{"type":22,"value":58},"То есть даже если ваш хостинг-аккаунт занимает всего 2 ГБ из доступных 10 ГБ, но на нём 300 000 мелких файлов — вы можете исчерпать лимит inodes. Большинство шаред-хостингов (Hosting Ukraine, Cityhost, FreeHost) устанавливают лимит в ",{"type":16,"tag":40,"props":60,"children":61},{},[62],{"type":22,"value":63},"200 000 – 500 000 inodes",{"type":22,"value":53},{"type":16,"tag":24,"props":66,"children":67},{},[68],{"type":16,"tag":40,"props":69,"children":70},{},[71],{"type":22,"value":72},"Простой пример:",{"type":16,"tag":74,"props":75,"children":76},"ul",{},[77,92,104,116],{"type":16,"tag":78,"props":79,"children":80},"li",{},[81,83,90],{"type":22,"value":82},"Фотография ",{"type":16,"tag":84,"props":85,"children":87},"code",{"className":86},[],[88],{"type":22,"value":89},"photo.jpg",{"type":22,"value":91}," = 1 inode",{"type":16,"tag":78,"props":93,"children":94},{},[95,97,103],{"type":22,"value":96},"Папка ",{"type":16,"tag":84,"props":98,"children":100},{"className":99},[],[101],{"type":22,"value":102},"\u002Fimages\u002F",{"type":22,"value":91},{"type":16,"tag":78,"props":105,"children":106},{},[107,109,115],{"type":22,"value":108},"PHP-файл плагина ",{"type":16,"tag":84,"props":110,"children":112},{"className":111},[],[113],{"type":22,"value":114},"plugin.php",{"type":22,"value":91},{"type":16,"tag":78,"props":117,"children":118},{},[119,121,127],{"type":22,"value":120},"Кеш-файл ",{"type":16,"tag":84,"props":122,"children":124},{"className":123},[],[125],{"type":22,"value":126},"cache_page_123.html",{"type":22,"value":91},{"type":16,"tag":24,"props":129,"children":130},{},[131,133,138],{"type":22,"value":132},"А теперь представьте: свежий WordPress с одной темой и десятком плагинов — это уже ",{"type":16,"tag":40,"props":134,"children":135},{},[136],{"type":22,"value":137},"30 000 – 50 000 файлов",{"type":22,"value":139},". Добавьте кеш, бэкапы, логи, загруженные медиафайлы — и лимит исчерпан.",{"type":16,"tag":30,"props":141,"children":143},{"id":142},"почему-иноды-заканчиваются-главные-причины",[144],{"type":22,"value":145},"Почему иноды заканчиваются: главные причины",{"type":16,"tag":147,"props":148,"children":150},"h3",{"id":149},"_1-файлы-кеша-причина-1",[151],{"type":22,"value":152},"1. Файлы кеша (причина №1)",{"type":16,"tag":24,"props":154,"children":155},{},[156,158,163],{"type":22,"value":157},"Плагины кеширования (LiteSpeed Cache, W3 Total Cache, WP Super Cache) создают отдельный HTML-файл для ",{"type":16,"tag":40,"props":159,"children":160},{},[161],{"type":22,"value":162},"каждой страницы",{"type":22,"value":164}," вашего сайта. Если у вас интернет-магазин с 10 000 товаров — это минимум 10 000 файлов кеша. А если кеш создаётся отдельно для мобильной и десктопной версии — уже 20 000.",{"type":16,"tag":24,"props":166,"children":167},{},[168,170,175],{"type":22,"value":169},"Добавьте сюда кеш для разных валют, языков, cookie-вариаций — и количество файлов может достигать ",{"type":16,"tag":40,"props":171,"children":172},{},[173],{"type":22,"value":174},"100 000+",{"type":22,"value":176}," только от одного плагина.",{"type":16,"tag":147,"props":178,"children":180},{"id":179},"_2-старые-бэкапы-на-хостинге",[181],{"type":22,"value":182},"2. Старые бэкапы на хостинге",{"type":16,"tag":24,"props":184,"children":185},{},[186,188,193],{"type":22,"value":187},"Многие настраивают автоматические бэкапы (через UpdraftPlus, All-in-One WP Migration или встроенные средства хостинга) и забывают о них. Каждый бэкап — это ZIP-архив, но некоторые плагины хранят бэкапы ",{"type":16,"tag":40,"props":189,"children":190},{},[191],{"type":22,"value":192},"без архивации",{"type":22,"value":194},", просто копируя все файлы сайта. Три таких бэкапа — и вы втрое превысили лимит.",{"type":16,"tag":147,"props":196,"children":198},{"id":197},"_3-логи-и-временные-файлы",[199],{"type":22,"value":200},"3. Логи и временные файлы",{"type":16,"tag":74,"props":202,"children":203},{},[204,217,230,235],{"type":16,"tag":78,"props":205,"children":206},{},[207,209,215],{"type":22,"value":208},"Файлы сессий PHP (",{"type":16,"tag":84,"props":210,"children":212},{"className":211},[],[213],{"type":22,"value":214},"\u002Ftmp\u002Fsess_*",{"type":22,"value":216},") — могут накапливаться тысячами",{"type":16,"tag":78,"props":218,"children":219},{},[220,222,228],{"type":22,"value":221},"Логи ошибок (",{"type":16,"tag":84,"props":223,"children":225},{"className":224},[],[226],{"type":22,"value":227},"error_log",{"type":22,"value":229},") — могут быть в каждой папке сайта",{"type":16,"tag":78,"props":231,"children":232},{},[233],{"type":22,"value":234},"Временные файлы загрузок",{"type":16,"tag":78,"props":236,"children":237},{},[238],{"type":22,"value":239},"Файлы email-очереди",{"type":16,"tag":147,"props":241,"children":243},{"id":242},"_4-неудалённые-плагины-и-темы-wordpress",[244],{"type":22,"value":245},"4. Неудалённые плагины и темы (WordPress)",{"type":16,"tag":24,"props":247,"children":248},{},[249],{"type":22,"value":250},"Каждая тема WordPress — это 500–2000 файлов. Каждый плагин — от 50 до 5000 файлов. Если вы установили 10 тем «на пробу» и не удалили 8 из них — это десятки тысяч ненужных файлов.",{"type":16,"tag":147,"props":252,"children":254},{"id":253},"_5-node_modules-и-файлы-разработки",[255],{"type":22,"value":256},"5. Node_modules и файлы разработки",{"type":16,"tag":24,"props":258,"children":259},{},[260,262,268,270,275,277,283,285,291],{"type":22,"value":261},"Если разработчик оставил на хостинге папку ",{"type":16,"tag":84,"props":263,"children":265},{"className":264},[],[266],{"type":22,"value":267},"node_modules",{"type":22,"value":269}," — это легко ",{"type":16,"tag":40,"props":271,"children":272},{},[273],{"type":22,"value":274},"50 000 – 200 000 файлов",{"type":22,"value":276}," одним ударом. То же касается ",{"type":16,"tag":84,"props":278,"children":280},{"className":279},[],[281],{"type":22,"value":282},".git",{"type":22,"value":284},", ",{"type":16,"tag":84,"props":286,"children":288},{"className":287},[],[289],{"type":22,"value":290},"vendor",{"type":22,"value":292}," со всеми dev-зависимостями, папок сборки и т.п.",{"type":16,"tag":147,"props":294,"children":296},{"id":295},"_6-миниатюры-изображений",[297],{"type":22,"value":298},"6. Миниатюры изображений",{"type":16,"tag":24,"props":300,"children":301},{},[302],{"type":22,"value":303},"WordPress автоматически создаёт несколько копий каждого загруженного изображения (миниатюра, средний размер, большой размер, и другие, заданные темой). Загрузили 1 000 фото — получили 5 000 – 8 000 файлов.",{"type":16,"tag":30,"props":305,"children":307},{"id":306},"как-узнать-сколько-inodes-используется",[308],{"type":22,"value":309},"Как узнать, сколько inodes используется?",{"type":16,"tag":147,"props":311,"children":313},{"id":312},"через-cpanel",[314],{"type":22,"value":315},"Через cPanel",{"type":16,"tag":24,"props":317,"children":318},{},[319],{"type":22,"value":320},"Зайдите в cPanel → на главной странице в боковой панели будет показатель «Inodes Used» или «File Usage».",{"type":16,"tag":147,"props":322,"children":324},{"id":323},"через-ssh-если-есть-доступ",[325],{"type":22,"value":326},"Через SSH (если есть доступ)",{"type":16,"tag":328,"props":329,"children":334},"pre",{"className":330,"code":332,"language":333,"meta":7},[331],"language-bash","# Общее количество файлов на аккаунте\nfind \u002Fhome\u002Fusername\u002F -type f | wc -l\n\n# Количество файлов в каждой папке (топ-10 самых больших)\nfind \u002Fhome\u002Fusername\u002Fpublic_html\u002F -type d -exec sh -c 'echo \"$(find \"{}\" -maxdepth 1 -type f | wc -l) {}\"' \\; | sort -rn | head -20\n\n# Найти папки с наибольшим количеством файлов\ndu --inodes -S \u002Fhome\u002Fusername\u002Fpublic_html\u002F | sort -rn | head -20\n","bash",[335],{"type":16,"tag":84,"props":336,"children":337},{"__ignoreMap":7},[338],{"type":22,"value":332},{"type":16,"tag":147,"props":340,"children":342},{"id":341},"через-файловый-менеджер-хостинга",[343],{"type":22,"value":344},"Через файловый менеджер хостинга",{"type":16,"tag":24,"props":346,"children":347},{},[348,350,356,357,363,364,370],{"type":22,"value":349},"Зайдите в файловый менеджер и посмотрите на размер папок ",{"type":16,"tag":84,"props":351,"children":353},{"className":352},[],[354],{"type":22,"value":355},"wp-content\u002Fcache\u002F",{"type":22,"value":284},{"type":16,"tag":84,"props":358,"children":360},{"className":359},[],[361],{"type":22,"value":362},"wp-content\u002Fuploads\u002F",{"type":22,"value":284},{"type":16,"tag":84,"props":365,"children":367},{"className":366},[],[368],{"type":22,"value":369},"wp-content\u002Fplugins\u002F",{"type":22,"value":371}," — обычно «пожиратели» именно там.",{"type":16,"tag":30,"props":373,"children":375},{"id":374},"как-освободить-иноды-пошаговая-инструкция",[376],{"type":22,"value":377},"Как освободить иноды: пошаговая инструкция",{"type":16,"tag":147,"props":379,"children":381},{"id":380},"шаг-1-очистите-кеш",[382],{"type":22,"value":383},"Шаг 1. Очистите кеш",{"type":16,"tag":24,"props":385,"children":386},{},[387,392],{"type":16,"tag":40,"props":388,"children":389},{},[390],{"type":22,"value":391},"WordPress (LiteSpeed Cache):",{"type":22,"value":393},"\nАдмин-панель → LiteSpeed Cache → Toolbox → Purge All",{"type":16,"tag":24,"props":395,"children":396},{},[397,402],{"type":16,"tag":40,"props":398,"children":399},{},[400],{"type":22,"value":401},"WordPress (W3 Total Cache):",{"type":22,"value":403},"\nPerformance → Dashboard → Empty All Caches",{"type":16,"tag":24,"props":405,"children":406},{},[407,412,414,419],{"type":16,"tag":40,"props":408,"children":409},{},[410],{"type":22,"value":411},"Или через файловый менеджер:",{"type":22,"value":413},"\nУдалите содержимое папки ",{"type":16,"tag":84,"props":415,"children":417},{"className":416},[],[418],{"type":22,"value":355},{"type":22,"value":420}," (саму папку оставьте).",{"type":16,"tag":24,"props":422,"children":423},{},[424,429],{"type":16,"tag":40,"props":425,"children":426},{},[427],{"type":22,"value":428},"После очистки",{"type":22,"value":430}," настройте автоматическое удаление старого кеша (TTL) — например, хранить кеш не более 7 дней.",{"type":16,"tag":147,"props":432,"children":434},{"id":433},"шаг-2-удалите-старые-бэкапы",[435],{"type":22,"value":436},"Шаг 2. Удалите старые бэкапы",{"type":16,"tag":24,"props":438,"children":439},{},[440],{"type":22,"value":441},"Проверьте такие папки:",{"type":16,"tag":74,"props":443,"children":444},{},[445,456,467,478],{"type":16,"tag":78,"props":446,"children":447},{},[448,454],{"type":16,"tag":84,"props":449,"children":451},{"className":450},[],[452],{"type":22,"value":453},"wp-content\u002Fupdraft\u002F",{"type":22,"value":455}," (UpdraftPlus)",{"type":16,"tag":78,"props":457,"children":458},{},[459,465],{"type":16,"tag":84,"props":460,"children":462},{"className":461},[],[463],{"type":22,"value":464},"wp-content\u002Fai1wm-backups\u002F",{"type":22,"value":466}," (All-in-One WP Migration)",{"type":16,"tag":78,"props":468,"children":469},{},[470,476],{"type":16,"tag":84,"props":471,"children":473},{"className":472},[],[474],{"type":22,"value":475},"wp-content\u002Fbackups-ew\u002F",{"type":22,"value":477}," и подобные",{"type":16,"tag":78,"props":479,"children":480},{},[481,483,489],{"type":22,"value":482},"Корневую папку хостинг-аккаунта (часто бэкапы лежат рядом с ",{"type":16,"tag":84,"props":484,"children":486},{"className":485},[],[487],{"type":22,"value":488},"public_html",{"type":22,"value":490},")",{"type":16,"tag":24,"props":492,"children":493},{},[494,496,501],{"type":22,"value":495},"Оставьте максимум 1–2 последних бэкапа, остальные удалите. А ещё лучше — ",{"type":16,"tag":40,"props":497,"children":498